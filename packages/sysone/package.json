{
  "name": "sysone",
  "version": "0.3.0",
  "description": "Zero-dependency TypeScript primitives for evaluation models. Predicates, classifiers, rubrics and collections.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "size.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/typesafe": {
      "types": "./dist/providers/typesafe.d.ts",
      "import": "./dist/providers/typesafe.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "import": "./dist/providers/vercel.js"
    },
    "./package.json": "./package.json",
    "./providers/system-one": {
      "types": "./dist/providers/system-one.d.ts",
      "import": "./dist/providers/system-one.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Sysone contributors",
  "homepage": "https://sysone.help",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sysone-help/sysone.git",
    "directory": "packages/sysone"
  },
  "bugs": {
    "url": "https://github.com/sysone-help/sysone/issues"
  },
  "keywords": [
    "typescript",
    "jev",
    "system-one",
    "classification",
    "evaluation",
    "ai"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
