{
  "name": "sysone-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "npm run build -w sysone && node scripts/example-snippets.mjs && npm run build -w @sysone/site && tsx --tsconfig site/tsconfig.json scripts/prerender.tsx",
    "test": "npm test -w sysone",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "check": "npm run build && npm run typecheck && npm test && npm run test:api",
    "dev": "npm run dev -w @sysone/site",
    "test:api": "tsx --test tests/*.test.ts",
    "dev:api": "tsx scripts/dev-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node scripts/package-smoke.mjs",
    "size": "node scripts/package-size.mjs",
    "size:write": "node scripts/package-size.mjs --write"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prettier": "3.9.8",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  }
}
